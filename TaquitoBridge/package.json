{
  "name": "signet-taquito-bridge",
  "private": true,
  "version": "0.1.0",
  "description": "Bundles Taquito into a single script that Signet loads in JavaScriptCore.",
  "scripts": {
    "build": "esbuild src/index.js --bundle --format=iife --global-name=TaquitoBridge --platform=browser --target=safari17 --minify --outfile=../Signet/Resources/taquito-bridge.js",
    "build:dev": "esbuild src/index.js --bundle --format=iife --global-name=TaquitoBridge --platform=browser --target=safari17 --sourcemap=inline --outfile=../Signet/Resources/taquito-bridge.js",
    "test:dapp-prepared": "node test/dapp-prepared.cjs",
    "test:dapp-identity": "node test/dapp-identity.cjs",
    "test": "npm run test:dapp-prepared && npm run test:dapp-identity && npm run test:approved-limits && npm run test:audit-boundaries && npm run test:bridge && npm run test:etherlink-governance && npm run test:tokens && npm run test:signing-exports && npm run test:confirmation && npm run test:pending-recovery && npm run test:read-only-signer && npm run test:tzel && npm run test:tzel-shield && npm run test:tzel-unshield && npm run test:tzel-transfer",
    "test:bridge": "node test/bridge.cjs",
    "test:etherlink-governance": "node test/etherlink-governance.cjs",
    "test:tokens": "node test/tokens.cjs",
    "test:tzel": "node test/tzel-vectors.cjs",
    "test:tzel-shield": "node test/tzel-shield.cjs",
    "test:tzel-unshield": "node test/tzel-unshield.cjs",
    "test:tzel-transfer": "node test/tzel-transfer.cjs",
    "test:approved-limits": "node test/approved-limits.cjs",
    "test:audit-boundaries": "node test/audit-boundaries.cjs",
    "test:signing-exports": "node test/signing-exports.cjs",
    "test:confirmation": "node test/confirmation.cjs",
    "test:pending-recovery": "node test/pending-recovery.cjs",
    "test:read-only-signer": "node test/read-only-signer.cjs"
  },
  "devDependencies": {
    "acorn": "8.19.0",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@ledgerhq/hw-transport": "^6.36.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "^0.7.1",
    "@scure/bip39": "^2.4.0",
    "@stablelib/nacl": "^1.0.4",
    "@tezos-x/octez.connect-wallet": "^5.0.5",
    "@tezos-x/octez.js": "25.1.0-rc.1",
    "@tezos-x/octez.js-ledger-signer": "25.1.0-rc.1",
    "@tezos-x/octez.js-local-forging": "25.1.0-rc.1",
    "@tezos-x/octez.js-michel-codec": "25.1.0-rc.1",
    "@tezos-x/octez.js-rpc": "25.1.0-rc.1",
    "@tezos-x/octez.js-signer": "25.1.0-rc.1",
    "@tezos-x/octez.js-utils": "25.1.0-rc.1",
    "bs58check": "^3.0.1",
    "buffer": "^6.0.3",
    "events": "^3.3.0"
  }
}
