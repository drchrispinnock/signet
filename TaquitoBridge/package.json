{
  "name": "signet-taquito-bridge",
  "private": true,
  "version": "0.1.0",
  "description": "Bundles Taquito into a single script that Signet loads in JavaScriptCore.",
  "scripts": {
    "build": "esbuild src/index.js --bundle --format=iife --global-name=TaquitoBridge --platform=browser --target=safari17 --minify --outfile=../Signet/Resources/taquito-bridge.js",
    "build:dev": "esbuild src/index.js --bundle --format=iife --global-name=TaquitoBridge --platform=browser --target=safari17 --sourcemap=inline --outfile=../Signet/Resources/taquito-bridge.js",
    "test:dapp-prepared": "node test/dapp-prepared.cjs",
    "test:dapp-identity": "node test/dapp-identity.cjs",
    "test": "npm run test:dapp-prepared && npm run test:dapp-identity && npm run test:approved-limits && npm run test:audit-boundaries && npm run test:bridge && npm run test:signing-exports && npm run test:confirmation && npm run test:read-only-signer",
    "test:bridge": "node test/bridge.cjs",
    "test:approved-limits": "node test/approved-limits.cjs",
    "test:audit-boundaries": "node test/audit-boundaries.cjs",
    "test:signing-exports": "node test/signing-exports.cjs",
    "test:confirmation": "node test/confirmation.cjs",
    "test:read-only-signer": "node test/read-only-signer.cjs"
  },
  "devDependencies": {
    "@taquito/taquito": "^25.1.0-beta0",
    "@taquito/utils": "^25.1.0-beta0",
    "acorn": "8.19.0",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@ledgerhq/hw-transport": "^6.36.0",
    "@taquito/ledger-signer": "^25.1.0-beta0",
    "@taquito/signer": "^25.1.0-beta0",
    "@tezos-x/octez.connect-wallet": "^5.0.4",
    "buffer": "^6.0.3",
    "events": "^3.3.0"
  }
}
