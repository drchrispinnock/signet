<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Not sandboxed: the wallet reads and writes ~/.tezos-client like octez-client does. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- JavaScriptCore needs its JIT under the hardened runtime; without it the Taquito bridge
	     (and especially PBKDF2 for encrypted keys) runs interpreted and is orders of magnitude slower. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
